{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbms",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "vars": {
    "CBMS_API_ORIGIN": "https://cbms-backend-staging.onrender.com",
  },
  "previews": {
    "vars": {
      "CBMS_API_ORIGIN": "https://cbms-backend-staging.onrender.com",
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
}
